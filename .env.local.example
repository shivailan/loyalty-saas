# Copiez ce fichier en ".env.local" (jamais commité dans git) et remplissez les vraies valeurs.
# Ces deux valeurs se trouvent dans Supabase : Project Settings > Data API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret absolu : contourne toute la sécurité RLS. Jamais exposé au navigateur,
# jamais préfixé par NEXT_PUBLIC_. Project Settings > Data API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Clé API Resend (resend.com > API Keys). Jamais exposée au navigateur.
RESEND_API_KEY=
